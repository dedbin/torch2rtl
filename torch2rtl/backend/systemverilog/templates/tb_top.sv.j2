module tb_top;
    localparam int DATA_BITS = {{ data_bits }};
    localparam int FRAC_BITS = {{ frac_bits }};
    localparam int ACC_BITS = {{ acc_bits }};
    localparam int INPUT_SIZE = {{ input_size }};
    localparam int CLASS_COUNT = {{ class_count }};
    localparam int CLASS_BITS = {{ class_bits }};

    logic signed [INPUT_SIZE*DATA_BITS-1:0] in_data;
    logic [CLASS_BITS-1:0] class_id;
    logic signed [CLASS_COUNT*DATA_BITS-1:0] logits;

    integer fd_inputs;
    integer fd_expected;
    integer status;
    integer idx;
    integer tmp;
    integer expected_class;
    integer vector_idx;
    integer errors;

    top dut (
        .in_data(in_data),
        .class_id(class_id),
        .logits(logits)
    );

    initial begin
        fd_inputs = $fopen("input_vectors.txt", "r");
        fd_expected = $fopen("expected_classes.txt", "r");
        if (fd_inputs == 0 || fd_expected == 0) begin
            $display("FAIL: could not open vector files");
            $finish(1);
        end

        vector_idx = 0;
        errors = 0;
        while ($fscanf(fd_expected, "%d", expected_class) == 1) begin
            for (idx = 0; idx < INPUT_SIZE; idx = idx + 1) begin
                status = $fscanf(fd_inputs, "%d", tmp);
                if (status != 1) begin
                    $display("FAIL vector=%0d input=%0d missing input value", vector_idx, idx);
                    errors = errors + 1;
                    tmp = 0;
                end
                in_data[idx*DATA_BITS +: DATA_BITS] = tmp[DATA_BITS-1:0];
            end
            #1;
            if (class_id !== expected_class[CLASS_BITS-1:0]) begin
                $display("FAIL vector=%0d expected=%0d got=%0d", vector_idx, expected_class, class_id);
                errors = errors + 1;
            end
            vector_idx = vector_idx + 1;
        end
        status = $fscanf(fd_inputs, "%d", tmp);
        if (status == 1) begin
            $display("FAIL: extra input values after expected classes");
            errors = errors + 1;
        end

        if (errors == 0) begin
            $display("PASS vectors=%0d", vector_idx);
            $finish(0);
        end
        $display("FAIL errors=%0d", errors);
        $finish(1);
    end
endmodule
