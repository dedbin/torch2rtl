module tb_top;
    localparam int DATA_BITS = {{ data_bits }};
    localparam int FRAC_BITS = {{ frac_bits }};
    localparam int ACC_BITS = {{ acc_bits }};
    localparam int INPUT_SIZE = {{ input_size }};
    localparam int CLASS_COUNT = {{ class_count }};
    localparam int CLASS_BITS = {{ class_bits }};
    localparam int EXPECTED_VECTORS = {{ expected_vectors }};
    localparam longint signed DATA_MIN = -64'sd{{ data_min_abs }};
    localparam longint signed DATA_MAX = 64'sd{{ data_max }};

    logic signed [INPUT_SIZE*DATA_BITS-1:0] in_data;
    logic [CLASS_BITS-1:0] class_id;
    logic signed [CLASS_COUNT*DATA_BITS-1:0] logits;

    integer fd_inputs;
    integer fd_logits;
    integer fd_expected;
    integer status;
    integer parse_status;
    integer idx;
    string token;
    longint signed tmp;
    longint signed expected_class;
    longint signed expected_logit;
    logic signed [DATA_BITS-1:0] actual_logit;
    integer logit_idx;
    integer vector_idx;
    integer errors;

    function automatic bit is_canonical_decimal(input string value);
        integer char_idx;
        integer digit_start;
        integer value_length;
        begin
            value_length = value.len();
            digit_start = 0;
            is_canonical_decimal = (value_length > 0);
            if (is_canonical_decimal && value[0] == "-") begin
                digit_start = 1;
                if (value_length == 1 || value[1] == "0") begin
                    is_canonical_decimal = 0;
                end
            end else if (is_canonical_decimal && value_length > 1 && value[0] == "0") begin
                is_canonical_decimal = 0;
            end
            for (char_idx = digit_start; char_idx < value_length; char_idx = char_idx + 1) begin
                if (value[char_idx] < "0" || value[char_idx] > "9") begin
                    is_canonical_decimal = 0;
                end
            end
        end
    endfunction

    top dut (
        .in_data(in_data),
        .class_id(class_id),
        .logits(logits)
    );

    initial begin
        fd_inputs = $fopen("input_vectors.txt", "r");
        fd_expected = $fopen("expected_classes.txt", "r");
        fd_logits = $fopen("expected_logits.txt", "r");
        if (fd_inputs == 0 || fd_expected == 0 || fd_logits == 0) begin
            $display("FAIL: could not open vector files");
            $fatal(1);
        end
        if (EXPECTED_VECTORS <= 0) begin
            $display("FAIL: expected vector count must be positive");
            $fatal(1);
        end

        errors = 0;
        for (vector_idx = 0; vector_idx < EXPECTED_VECTORS; vector_idx = vector_idx + 1) begin
            status = $fscanf(fd_expected, "%s", token);
            if (status != 1) begin
                $display("FAIL vector=%0d missing expected class", vector_idx);
                errors = errors + 1;
                expected_class = 0;
            end else begin
                parse_status = 0;
                if (is_canonical_decimal(token)) begin
                    parse_status = $sscanf(token, "%d", expected_class);
                end
                if (parse_status != 1 || $isunknown(expected_class) || token != $sformatf("%0d", expected_class)) begin
                    $display("FAIL vector=%0d malformed expected class: %s", vector_idx, token);
                    errors = errors + 1;
                    expected_class = 0;
                end else if (expected_class < 0 || expected_class >= CLASS_COUNT) begin
                    $display("FAIL vector=%0d expected class out of range: %0d", vector_idx, expected_class);
                    errors = errors + 1;
                end
            end
            for (idx = 0; idx < INPUT_SIZE; idx = idx + 1) begin
                status = $fscanf(fd_inputs, "%s", token);
                if (status != 1) begin
                    $display("FAIL vector=%0d input=%0d missing input value", vector_idx, idx);
                    errors = errors + 1;
                    tmp = 0;
                end else begin
                    parse_status = 0;
                    if (is_canonical_decimal(token)) begin
                        parse_status = $sscanf(token, "%d", tmp);
                    end
                    if (parse_status != 1 || $isunknown(tmp) || token != $sformatf("%0d", tmp)) begin
                        $display("FAIL vector=%0d input=%0d malformed value: %s", vector_idx, idx, token);
                        errors = errors + 1;
                        tmp = 0;
                    end else if (tmp < DATA_MIN || tmp > DATA_MAX) begin
                        $display("FAIL vector=%0d input=%0d value out of range: %0d", vector_idx, idx, tmp);
                        errors = errors + 1;
                    end
                end
                in_data[idx*DATA_BITS +: DATA_BITS] = tmp[DATA_BITS-1:0];
            end
            #1;
            if (expected_class >= 0 && expected_class < CLASS_COUNT && class_id !== expected_class[CLASS_BITS-1:0]) begin
                $display("FAIL vector=%0d expected=%0d got=%0d", vector_idx, expected_class, class_id);
                errors = errors + 1;
            end
            for (logit_idx = 0; logit_idx < CLASS_COUNT; logit_idx = logit_idx + 1) begin
                status = $fscanf(fd_logits, "%s", token);
                if (status != 1) begin
                    $display("FAIL vector=%0d logit=%0d missing expected logit value", vector_idx, logit_idx);
                    errors = errors + 1;
                end else begin
                    parse_status = 0;
                    if (is_canonical_decimal(token)) begin
                        parse_status = $sscanf(token, "%d", expected_logit);
                    end
                    if (parse_status != 1 || $isunknown(expected_logit) || token != $sformatf("%0d", expected_logit)) begin
                        $display("FAIL vector=%0d logit=%0d malformed expected value: %s", vector_idx, logit_idx, token);
                        errors = errors + 1;
                    end else if (expected_logit < DATA_MIN || expected_logit > DATA_MAX) begin
                        $display("FAIL vector=%0d logit=%0d expected value out of range: %0d", vector_idx, logit_idx, expected_logit);
                        errors = errors + 1;
                    end else begin
                        actual_logit = $signed(logits[logit_idx*DATA_BITS +: DATA_BITS]);
                        if (actual_logit !== expected_logit) begin
                            $display("FAIL vector=%0d logit=%0d expected=%0d got=%0d", vector_idx, logit_idx, expected_logit, actual_logit);
                            errors = errors + 1;
                        end
                    end
                end
            end
        end

        status = $fscanf(fd_inputs, "%s", token);
        if (status != -1 && !$feof(fd_inputs)) begin
            $display("FAIL: extra or malformed input data after expected vectors");
            errors = errors + 1;
        end
        status = $fscanf(fd_expected, "%s", token);
        if (status != -1 && !$feof(fd_expected)) begin
            $display("FAIL: extra or malformed expected class data");
            errors = errors + 1;
        end
        status = $fscanf(fd_logits, "%s", token);
        if (status != -1 && !$feof(fd_logits)) begin
            $display("FAIL: extra or malformed expected logit data");
            errors = errors + 1;
        end

        $fclose(fd_inputs);
        $fclose(fd_expected);
        $fclose(fd_logits);

        if (errors == 0 && vector_idx == EXPECTED_VECTORS) begin
            $display("PASS vectors=%0d", vector_idx);
            $finish(0);
        end
        $display("FAIL errors=%0d", errors);
        $fatal(1);
    end
endmodule
