module relu #(
    parameter int FEATURES = 1,
    parameter int DATA_BITS = {{ data_bits }}
) (
    input  logic signed [FEATURES*DATA_BITS-1:0] in_data,
    output logic signed [FEATURES*DATA_BITS-1:0] out_data
);
    integer idx;
    logic signed [DATA_BITS-1:0] value;
    localparam logic signed [DATA_BITS-1:0] ZERO_Q = '0;

    function automatic logic signed [DATA_BITS-1:0] input_at(
        input logic signed [FEATURES*DATA_BITS-1:0] values,
        input integer index
    );
        begin
            input_at = values[index*DATA_BITS +: DATA_BITS];
        end
    endfunction

    always_comb begin
        for (idx = 0; idx < FEATURES; idx = idx + 1) begin
            value = input_at(in_data, idx);
            if (value < ZERO_Q) begin
                out_data[idx*DATA_BITS +: DATA_BITS] = ZERO_Q;
            end else begin
                out_data[idx*DATA_BITS +: DATA_BITS] = value;
            end
        end
    end
endmodule
